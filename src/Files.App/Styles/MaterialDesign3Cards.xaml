<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!--  Material Design 3 Filled Card Style  -->
	<Style x:Key="MD3FilledCardStyle" TargetType="Border">
		<Setter Property="Background" Value="{ThemeResource MD3.SurfaceVariantBrush}" />
		<Setter Property="BorderBrush" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="CornerRadius" Value="{StaticResource MD3.Shape.CornerRadius.Medium}" />
		<Setter Property="Padding" Value="16" />
	</Style>

	<!--  Material Design 3 Elevated Card Style  -->
	<Style x:Key="MD3ElevatedCardStyle" TargetType="Border">
		<Setter Property="Background" Value="{ThemeResource MD3.SurfaceBrush}" />
		<Setter Property="BorderBrush" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="CornerRadius" Value="{StaticResource MD3.Shape.CornerRadius.Medium}" />
		<Setter Property="Padding" Value="16" />
		<!--  Note: WinUI 3 doesn't have built-in shadow/elevation support like Material Design  -->
		<!--  We use a subtle border to simulate elevation  -->
	</Style>

	<!--  Material Design 3 Outlined Card Style  -->
	<Style x:Key="MD3OutlinedCardStyle" TargetType="Border">
		<Setter Property="Background" Value="{ThemeResource MD3.SurfaceBrush}" />
		<Setter Property="BorderBrush" Value="{ThemeResource MD3.OutlineVariantBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="{StaticResource MD3.Shape.CornerRadius.Medium}" />
		<Setter Property="Padding" Value="16" />
	</Style>

</ResourceDictionary>
