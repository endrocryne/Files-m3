<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!--  Material Design 3 Color Tokens  -->
	<ResourceDictionary.ThemeDictionaries>
		<ResourceDictionary x:Key="Light">
			<!--  MD3 Primary Colors  -->
			<Color x:Key="MD3.Primary">#6750A4</Color>
			<Color x:Key="MD3.OnPrimary">#FFFFFF</Color>
			<Color x:Key="MD3.PrimaryContainer">#EADDFF</Color>
			<Color x:Key="MD3.OnPrimaryContainer">#21005D</Color>

			<!--  MD3 Secondary Colors  -->
			<Color x:Key="MD3.Secondary">#625B71</Color>
			<Color x:Key="MD3.OnSecondary">#FFFFFF</Color>
			<Color x:Key="MD3.SecondaryContainer">#E8DEF8</Color>
			<Color x:Key="MD3.OnSecondaryContainer">#1D192B</Color>

			<!--  MD3 Tertiary Colors  -->
			<Color x:Key="MD3.Tertiary">#7D5260</Color>
			<Color x:Key="MD3.OnTertiary">#FFFFFF</Color>
			<Color x:Key="MD3.TertiaryContainer">#FFD8E4</Color>
			<Color x:Key="MD3.OnTertiaryContainer">#31111D</Color>

			<!--  MD3 Error Colors  -->
			<Color x:Key="MD3.Error">#B3261E</Color>
			<Color x:Key="MD3.OnError">#FFFFFF</Color>
			<Color x:Key="MD3.ErrorContainer">#F9DEDC</Color>
			<Color x:Key="MD3.OnErrorContainer">#410E0B</Color>

			<!--  MD3 Surface Colors  -->
			<Color x:Key="MD3.Surface">#FFFBFE</Color>
			<Color x:Key="MD3.OnSurface">#1C1B1F</Color>
			<Color x:Key="MD3.SurfaceVariant">#E7E0EC</Color>
			<Color x:Key="MD3.OnSurfaceVariant">#49454F</Color>
			<Color x:Key="MD3.SurfaceTint">#6750A4</Color>

			<!--  MD3 Background Colors  -->
			<Color x:Key="MD3.Background">#FFFBFE</Color>
			<Color x:Key="MD3.OnBackground">#1C1B1F</Color>

			<!--  MD3 Outline Colors  -->
			<Color x:Key="MD3.Outline">#79747E</Color>
			<Color x:Key="MD3.OutlineVariant">#CAC4D0</Color>

			<!--  MD3 Inverse Colors  -->
			<Color x:Key="MD3.InverseSurface">#313033</Color>
			<Color x:Key="MD3.InverseOnSurface">#F4EFF4</Color>
			<Color x:Key="MD3.InversePrimary">#D0BCFF</Color>

			<!--  MD3 Shadow and Scrim  -->
			<Color x:Key="MD3.Shadow">#000000</Color>
			<Color x:Key="MD3.Scrim">#000000</Color>

			<!--  Brushes  -->
			<SolidColorBrush x:Key="MD3.PrimaryBrush" Color="{StaticResource MD3.Primary}" />
			<SolidColorBrush x:Key="MD3.OnPrimaryBrush" Color="{StaticResource MD3.OnPrimary}" />
			<SolidColorBrush x:Key="MD3.PrimaryContainerBrush" Color="{StaticResource MD3.PrimaryContainer}" />
			<SolidColorBrush x:Key="MD3.OnPrimaryContainerBrush" Color="{StaticResource MD3.OnPrimaryContainer}" />

			<SolidColorBrush x:Key="MD3.SecondaryBrush" Color="{StaticResource MD3.Secondary}" />
			<SolidColorBrush x:Key="MD3.OnSecondaryBrush" Color="{StaticResource MD3.OnSecondary}" />
			<SolidColorBrush x:Key="MD3.SecondaryContainerBrush" Color="{StaticResource MD3.SecondaryContainer}" />
			<SolidColorBrush x:Key="MD3.OnSecondaryContainerBrush" Color="{StaticResource MD3.OnSecondaryContainer}" />

			<SolidColorBrush x:Key="MD3.TertiaryBrush" Color="{StaticResource MD3.Tertiary}" />
			<SolidColorBrush x:Key="MD3.OnTertiaryBrush" Color="{StaticResource MD3.OnTertiary}" />
			<SolidColorBrush x:Key="MD3.TertiaryContainerBrush" Color="{StaticResource MD3.TertiaryContainer}" />
			<SolidColorBrush x:Key="MD3.OnTertiaryContainerBrush" Color="{StaticResource MD3.OnTertiaryContainer}" />

			<SolidColorBrush x:Key="MD3.ErrorBrush" Color="{StaticResource MD3.Error}" />
			<SolidColorBrush x:Key="MD3.OnErrorBrush" Color="{StaticResource MD3.OnError}" />
			<SolidColorBrush x:Key="MD3.ErrorContainerBrush" Color="{StaticResource MD3.ErrorContainer}" />
			<SolidColorBrush x:Key="MD3.OnErrorContainerBrush" Color="{StaticResource MD3.OnErrorContainer}" />

			<SolidColorBrush x:Key="MD3.SurfaceBrush" Color="{StaticResource MD3.Surface}" />
			<SolidColorBrush x:Key="MD3.OnSurfaceBrush" Color="{StaticResource MD3.OnSurface}" />
			<SolidColorBrush x:Key="MD3.SurfaceVariantBrush" Color="{StaticResource MD3.SurfaceVariant}" />
			<SolidColorBrush x:Key="MD3.OnSurfaceVariantBrush" Color="{StaticResource MD3.OnSurfaceVariant}" />

			<SolidColorBrush x:Key="MD3.BackgroundBrush" Color="{StaticResource MD3.Background}" />
			<SolidColorBrush x:Key="MD3.OnBackgroundBrush" Color="{StaticResource MD3.OnBackground}" />

			<SolidColorBrush x:Key="MD3.OutlineBrush" Color="{StaticResource MD3.Outline}" />
			<SolidColorBrush x:Key="MD3.OutlineVariantBrush" Color="{StaticResource MD3.OutlineVariant}" />

			<SolidColorBrush x:Key="MD3.InverseSurfaceBrush" Color="{StaticResource MD3.InverseSurface}" />
			<SolidColorBrush x:Key="MD3.InverseOnSurfaceBrush" Color="{StaticResource MD3.InverseOnSurface}" />
			<SolidColorBrush x:Key="MD3.InversePrimaryBrush" Color="{StaticResource MD3.InversePrimary}" />

			<!--  State layers (with opacity)  -->
			<SolidColorBrush x:Key="MD3.Primary.StateLayer.Hover" Color="#6750A4" Opacity="0.08" />
			<SolidColorBrush x:Key="MD3.Primary.StateLayer.Focus" Color="#6750A4" Opacity="0.12" />
			<SolidColorBrush x:Key="MD3.Primary.StateLayer.Pressed" Color="#6750A4" Opacity="0.12" />

			<!--  App Theme Mappings  -->
			<SolidColorBrush x:Key="App.Theme.BackgroundBrush" Color="{StaticResource MD3.Background}" />
			<SolidColorBrush x:Key="App.Theme.AddressBar.BackgroundBrush" Color="{StaticResource MD3.Surface}" />
			<SolidColorBrush x:Key="App.Theme.Toolbar.BackgroundBrush" Color="{StaticResource MD3.SurfaceVariant}" />
			<SolidColorBrush x:Key="App.Theme.Sidebar.BackgroundBrush" Color="{StaticResource MD3.Surface}" />
			<SolidColorBrush x:Key="App.Theme.FileArea.BackgroundBrush" Color="{StaticResource MD3.Background}" />
			<SolidColorBrush x:Key="App.Theme.FileArea.SecondaryBackgroundBrush" Color="{StaticResource MD3.SurfaceVariant}" />
			<SolidColorBrush x:Key="App.Theme.InfoPane.BackgroundBrush" Color="{StaticResource MD3.SurfaceVariant}" />

			<!--  Tab colors (Material Design 3 style)  -->
			<SolidColorBrush x:Key="TabViewItemHeaderBackground" Color="Transparent" />
			<SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="{StaticResource MD3.SecondaryContainer}" />
			<SolidColorBrush x:Key="TabViewItemHeaderBackgroundPressed" Color="{StaticResource MD3.SecondaryContainer}" Opacity="0.8" />
			<SolidColorBrush x:Key="TabViewItemHeaderBackgroundPointerOver" Color="{StaticResource MD3.SecondaryContainer}" Opacity="0.5" />

			<Color x:Key="App.Theme.FillColorAttention">#6750A4</Color>
			<SolidColorBrush x:Key="App.Theme.FillColorAttentionBrush" Color="{StaticResource App.Theme.FillColorAttention}" />
			<SolidColorBrush x:Key="App.Theme.CardBackgroundFillColorTertiaryBrush" Color="{StaticResource MD3.Surface}" />
		</ResourceDictionary>

		<ResourceDictionary x:Key="Dark">
			<!--  MD3 Primary Colors (Dark)  -->
			<Color x:Key="MD3.Primary">#D0BCFF</Color>
			<Color x:Key="MD3.OnPrimary">#381E72</Color>
			<Color x:Key="MD3.PrimaryContainer">#4F378B</Color>
			<Color x:Key="MD3.OnPrimaryContainer">#EADDFF</Color>

			<!--  MD3 Secondary Colors (Dark)  -->
			<Color x:Key="MD3.Secondary">#CCC2DC</Color>
			<Color x:Key="MD3.OnSecondary">#332D41</Color>
			<Color x:Key="MD3.SecondaryContainer">#4A4458</Color>
			<Color x:Key="MD3.OnSecondaryContainer">#E8DEF8</Color>

			<!--  MD3 Tertiary Colors (Dark)  -->
			<Color x:Key="MD3.Tertiary">#EFB8C8</Color>
			<Color x:Key="MD3.OnTertiary">#492532</Color>
			<Color x:Key="MD3.TertiaryContainer">#633B48</Color>
			<Color x:Key="MD3.OnTertiaryContainer">#FFD8E4</Color>

			<!--  MD3 Error Colors (Dark)  -->
			<Color x:Key="MD3.Error">#F2B8B5</Color>
			<Color x:Key="MD3.OnError">#601410</Color>
			<Color x:Key="MD3.ErrorContainer">#8C1D18</Color>
			<Color x:Key="MD3.OnErrorContainer">#F9DEDC</Color>

			<!--  MD3 Surface Colors (Dark)  -->
			<Color x:Key="MD3.Surface">#1C1B1F</Color>
			<Color x:Key="MD3.OnSurface">#E6E1E5</Color>
			<Color x:Key="MD3.SurfaceVariant">#49454F</Color>
			<Color x:Key="MD3.OnSurfaceVariant">#CAC4D0</Color>
			<Color x:Key="MD3.SurfaceTint">#D0BCFF</Color>

			<!--  MD3 Background Colors (Dark)  -->
			<Color x:Key="MD3.Background">#1C1B1F</Color>
			<Color x:Key="MD3.OnBackground">#E6E1E5</Color>

			<!--  MD3 Outline Colors (Dark)  -->
			<Color x:Key="MD3.Outline">#938F99</Color>
			<Color x:Key="MD3.OutlineVariant">#49454F</Color>

			<!--  MD3 Inverse Colors (Dark)  -->
			<Color x:Key="MD3.InverseSurface">#E6E1E5</Color>
			<Color x:Key="MD3.InverseOnSurface">#313033</Color>
			<Color x:Key="MD3.InversePrimary">#6750A4</Color>

			<!--  MD3 Shadow and Scrim  -->
			<Color x:Key="MD3.Shadow">#000000</Color>
			<Color x:Key="MD3.Scrim">#000000</Color>

			<!--  Brushes  -->
			<SolidColorBrush x:Key="MD3.PrimaryBrush" Color="{StaticResource MD3.Primary}" />
			<SolidColorBrush x:Key="MD3.OnPrimaryBrush" Color="{StaticResource MD3.OnPrimary}" />
			<SolidColorBrush x:Key="MD3.PrimaryContainerBrush" Color="{StaticResource MD3.PrimaryContainer}" />
			<SolidColorBrush x:Key="MD3.OnPrimaryContainerBrush" Color="{StaticResource MD3.OnPrimaryContainer}" />

			<SolidColorBrush x:Key="MD3.SecondaryBrush" Color="{StaticResource MD3.Secondary}" />
			<SolidColorBrush x:Key="MD3.OnSecondaryBrush" Color="{StaticResource MD3.OnSecondary}" />
			<SolidColorBrush x:Key="MD3.SecondaryContainerBrush" Color="{StaticResource MD3.SecondaryContainer}" />
			<SolidColorBrush x:Key="MD3.OnSecondaryContainerBrush" Color="{StaticResource MD3.OnSecondaryContainer}" />

			<SolidColorBrush x:Key="MD3.TertiaryBrush" Color="{StaticResource MD3.Tertiary}" />
			<SolidColorBrush x:Key="MD3.OnTertiaryBrush" Color="{StaticResource MD3.OnTertiary}" />
			<SolidColorBrush x:Key="MD3.TertiaryContainerBrush" Color="{StaticResource MD3.TertiaryContainer}" />
			<SolidColorBrush x:Key="MD3.OnTertiaryContainerBrush" Color="{StaticResource MD3.OnTertiaryContainer}" />

			<SolidColorBrush x:Key="MD3.ErrorBrush" Color="{StaticResource MD3.Error}" />
			<SolidColorBrush x:Key="MD3.OnErrorBrush" Color="{StaticResource MD3.OnError}" />
			<SolidColorBrush x:Key="MD3.ErrorContainerBrush" Color="{StaticResource MD3.ErrorContainer}" />
			<SolidColorBrush x:Key="MD3.OnErrorContainerBrush" Color="{StaticResource MD3.OnErrorContainer}" />

			<SolidColorBrush x:Key="MD3.SurfaceBrush" Color="{StaticResource MD3.Surface}" />
			<SolidColorBrush x:Key="MD3.OnSurfaceBrush" Color="{StaticResource MD3.OnSurface}" />
			<SolidColorBrush x:Key="MD3.SurfaceVariantBrush" Color="{StaticResource MD3.SurfaceVariant}" />
			<SolidColorBrush x:Key="MD3.OnSurfaceVariantBrush" Color="{StaticResource MD3.OnSurfaceVariant}" />

			<SolidColorBrush x:Key="MD3.BackgroundBrush" Color="{StaticResource MD3.Background}" />
			<SolidColorBrush x:Key="MD3.OnBackgroundBrush" Color="{StaticResource MD3.OnBackground}" />

			<SolidColorBrush x:Key="MD3.OutlineBrush" Color="{StaticResource MD3.Outline}" />
			<SolidColorBrush x:Key="MD3.OutlineVariantBrush" Color="{StaticResource MD3.OutlineVariant}" />

			<SolidColorBrush x:Key="MD3.InverseSurfaceBrush" Color="{StaticResource MD3.InverseSurface}" />
			<SolidColorBrush x:Key="MD3.InverseOnSurfaceBrush" Color="{StaticResource MD3.InverseOnSurface}" />
			<SolidColorBrush x:Key="MD3.InversePrimaryBrush" Color="{StaticResource MD3.InversePrimary}" />

			<!--  State layers (with opacity)  -->
			<SolidColorBrush x:Key="MD3.Primary.StateLayer.Hover" Color="#D0BCFF" Opacity="0.08" />
			<SolidColorBrush x:Key="MD3.Primary.StateLayer.Focus" Color="#D0BCFF" Opacity="0.12" />
			<SolidColorBrush x:Key="MD3.Primary.StateLayer.Pressed" Color="#D0BCFF" Opacity="0.12" />

			<!--  App Theme Mappings  -->
			<SolidColorBrush x:Key="App.Theme.BackgroundBrush" Color="{StaticResource MD3.Background}" />
			<SolidColorBrush x:Key="App.Theme.AddressBar.BackgroundBrush" Color="{StaticResource MD3.Surface}" />
			<SolidColorBrush x:Key="App.Theme.Toolbar.BackgroundBrush" Color="{StaticResource MD3.SurfaceVariant}" />
			<SolidColorBrush x:Key="App.Theme.Sidebar.BackgroundBrush" Color="{StaticResource MD3.Surface}" />
			<SolidColorBrush x:Key="App.Theme.FileArea.BackgroundBrush" Color="{StaticResource MD3.Background}" />
			<SolidColorBrush x:Key="App.Theme.FileArea.SecondaryBackgroundBrush" Color="{StaticResource MD3.SurfaceVariant}" />
			<SolidColorBrush x:Key="App.Theme.InfoPane.BackgroundBrush" Color="{StaticResource MD3.SurfaceVariant}" />

			<!--  Tab colors (Material Design 3 style)  -->
			<SolidColorBrush x:Key="TabViewItemHeaderBackground" Color="Transparent" />
			<SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="{StaticResource MD3.SecondaryContainer}" />
			<SolidColorBrush x:Key="TabViewItemHeaderBackgroundPressed" Color="{StaticResource MD3.SecondaryContainer}" Opacity="0.8" />
			<SolidColorBrush x:Key="TabViewItemHeaderBackgroundPointerOver" Color="{StaticResource MD3.SecondaryContainer}" Opacity="0.5" />

			<Color x:Key="App.Theme.FillColorAttention">#D0BCFF</Color>
			<SolidColorBrush x:Key="App.Theme.FillColorAttentionBrush" Color="{StaticResource App.Theme.FillColorAttention}" />
			<SolidColorBrush x:Key="App.Theme.CardBackgroundFillColorTertiaryBrush" Color="{StaticResource MD3.Surface}" />
		</ResourceDictionary>

		<ResourceDictionary x:Key="HighContrast">
			<!--  Keep High Contrast as-is for accessibility  -->
			<SolidColorBrush x:Key="App.Theme.BackgroundBrush" Color="Transparent" />
			<SolidColorBrush x:Key="App.Theme.AddressBar.BackgroundBrush" Color="Transparent" />
			<SolidColorBrush x:Key="App.Theme.Toolbar.BackgroundBrush" Color="Transparent" />
			<SolidColorBrush x:Key="App.Theme.Sidebar.BackgroundBrush" Color="Transparent" />
			<SolidColorBrush x:Key="App.Theme.FileArea.BackgroundBrush" Color="Transparent" />
			<SolidColorBrush x:Key="App.Theme.FileArea.SecondaryBackgroundBrush" Color="Transparent" />
			<SolidColorBrush x:Key="App.Theme.InfoPane.BackgroundBrush" Color="Transparent" />

			<SolidColorBrush x:Key="TabViewItemHeaderBackground" Color="{StaticResource SystemColorWindowColor}" />
			<SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="{StaticResource SystemColorHighlightColor}" />
			<SolidColorBrush x:Key="TabViewItemHeaderBackgroundPressed" Color="{StaticResource SystemColorHighlightColor}" />
			<SolidColorBrush x:Key="TabViewItemHeaderBackgroundPointerOver" Color="{StaticResource SystemColorHighlightColor}" />

			<Color x:Key="App.Theme.FillColorAttention">#50C0FF</Color>
			<SolidColorBrush x:Key="App.Theme.FillColorAttentionBrush" Color="{StaticResource App.Theme.FillColorAttention}" />
			<SolidColorBrush x:Key="App.Theme.CardBackgroundFillColorTertiaryBrush" Color="{StaticResource SystemColorWindowColor}" />
		</ResourceDictionary>
	</ResourceDictionary.ThemeDictionaries>

	<!--  Material Design 3 Typography Scale  -->
	<!--  Display  -->
	<x:Double x:Key="MD3.Typography.Display.Large.Size">57</x:Double>
	<x:Double x:Key="MD3.Typography.Display.Medium.Size">45</x:Double>
	<x:Double x:Key="MD3.Typography.Display.Small.Size">36</x:Double>

	<!--  Headline  -->
	<x:Double x:Key="MD3.Typography.Headline.Large.Size">32</x:Double>
	<x:Double x:Key="MD3.Typography.Headline.Medium.Size">28</x:Double>
	<x:Double x:Key="MD3.Typography.Headline.Small.Size">24</x:Double>

	<!--  Title  -->
	<x:Double x:Key="MD3.Typography.Title.Large.Size">22</x:Double>
	<x:Double x:Key="MD3.Typography.Title.Medium.Size">16</x:Double>
	<x:Double x:Key="MD3.Typography.Title.Small.Size">14</x:Double>

	<!--  Body  -->
	<x:Double x:Key="MD3.Typography.Body.Large.Size">16</x:Double>
	<x:Double x:Key="MD3.Typography.Body.Medium.Size">14</x:Double>
	<x:Double x:Key="MD3.Typography.Body.Small.Size">12</x:Double>

	<!--  Label  -->
	<x:Double x:Key="MD3.Typography.Label.Large.Size">14</x:Double>
	<x:Double x:Key="MD3.Typography.Label.Medium.Size">12</x:Double>
	<x:Double x:Key="MD3.Typography.Label.Small.Size">11</x:Double>

	<!--  Material Design 3 Opacity Values for State Layers  -->
	<x:Double x:Key="MD3.StateLayer.Hover.Opacity">0.08</x:Double>
	<x:Double x:Key="MD3.StateLayer.Focus.Opacity">0.12</x:Double>
	<x:Double x:Key="MD3.StateLayer.Pressed.Opacity">0.12</x:Double>
	<x:Double x:Key="MD3.StateLayer.Dragged.Opacity">0.16</x:Double>
	
	<!--  Material Design 3 Opacity Values for Components  -->
	<x:Double x:Key="MD3.Component.Hover.Opacity">0.92</x:Double>
	<x:Double x:Key="MD3.Component.Pressed.Opacity">0.88</x:Double>
	<x:Double x:Key="MD3.Component.Disabled.Opacity">0.38</x:Double>

	<!--  Material Design 3 Shape Scale  -->
	<!--  Corner Radius - Material Design 3 uses more rounded corners  -->
	<CornerRadius x:Key="MD3.Shape.CornerRadius.None">0</CornerRadius>
	<CornerRadius x:Key="MD3.Shape.CornerRadius.ExtraSmall">4</CornerRadius>
	<CornerRadius x:Key="MD3.Shape.CornerRadius.Small">8</CornerRadius>
	<CornerRadius x:Key="MD3.Shape.CornerRadius.Medium">12</CornerRadius>
	<CornerRadius x:Key="MD3.Shape.CornerRadius.Large">16</CornerRadius>
	<CornerRadius x:Key="MD3.Shape.CornerRadius.ExtraLarge">28</CornerRadius>
	<CornerRadius x:Key="MD3.Shape.CornerRadius.Full">999</CornerRadius>

	<!--  Override default WinUI corner radius with Material Design 3 values  -->
	<!--  Note: These global overrides affect all WinUI controls for a consistent MD3 look  -->
	<!--  Component-specific styles can override these if needed  -->
	<CornerRadius x:Key="ControlCornerRadius">{StaticResource MD3.Shape.CornerRadius.Medium}</CornerRadius>
	<CornerRadius x:Key="OverlayCornerRadius">{StaticResource MD3.Shape.CornerRadius.Medium}</CornerRadius>
	<CornerRadius x:Key="GridViewThumbnailCornerRadius">{StaticResource MD3.Shape.CornerRadius.Medium}</CornerRadius>
	<CornerRadius x:Key="DetailsLayoutThumbnailCornerRadius">{StaticResource MD3.Shape.CornerRadius.Small}</CornerRadius>

	<!--  Material Design 3 Elevation (Shadow depth)  -->
	<x:Double x:Key="MD3.Elevation.Level0">0</x:Double>
	<x:Double x:Key="MD3.Elevation.Level1">1</x:Double>
	<x:Double x:Key="MD3.Elevation.Level2">3</x:Double>
	<x:Double x:Key="MD3.Elevation.Level3">6</x:Double>
	<x:Double x:Key="MD3.Elevation.Level4">8</x:Double>
	<x:Double x:Key="MD3.Elevation.Level5">12</x:Double>

</ResourceDictionary>
